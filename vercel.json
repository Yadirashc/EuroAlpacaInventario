{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/textile-cron",
      "schedule": "0 7 * * *"
    }
  ],
  "functions": {
    "api/textile.js": {
      "includeFiles": "node_modules/@jsquash/jxl/codec/dec/jxl_dec.wasm"
    }
  }
}
